<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- 머신 전역 소스(다른 사설 피드 등)를 상속하지 않는다 -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- 모든 패키지는 nuget.org에서만 받는다 (의존성 혼동 공격 방지) -->
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
